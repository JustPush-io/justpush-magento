<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="backend_auth_user_login_success">
        <observer name="justpush_admin_login" instance="JustPush\Notify\Observer\AdminLogin"/>
    </event>
    <event name="backend_auth_user_login_failed">
        <observer name="justpush_admin_login_failed" instance="JustPush\Notify\Observer\AdminLoginFailed"/>
    </event>
</config>
