{
    "name": "justpush/module-notify",
    "description": "Sends Magento 2 store events (orders, invoices, refunds, new customers, admin logins) to JustPush Studio as push notifications.",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": ["magento", "magento2", "justpush", "push notifications", "webhook"],
    "homepage": "https://justpush.app",
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0",
        "magento/framework": "^103.0.6",
        "magento/module-backend": "^102.0.6",
        "magento/module-config": "^101.2.6",
        "magento/module-customer": "^103.0.6",
        "magento/module-message-queue": "^100.4.6",
        "magento/module-mysql-mq": "^100.4.4",
        "magento/module-sales": "^103.0.6",
        "magento/module-store": "^101.1.6",
        "magento/module-user": "^101.2.6"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "JustPush\\Notify\\": ""
        }
    }
}
